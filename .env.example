# Copy to .env before running docker compose: cp .env.example .env

# Starts the bundled Postgres container. To use an external database instead,
# leave this empty (COMPOSE_PROFILES=) and point DATABASE_URL at that database.
COMPOSE_PROFILES=db

# Bundled Postgres container (keep in sync with DATABASE_URL below)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todo

# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# "db" is the compose service name. For a Postgres on your machine use host.docker.internal.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/todo
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/todo_test

ENV=development
LOG_LEVEL=INFO

# Host ports
API_PORT=8000
WEB_DEV_PORT=5173
WEB_PORT=8080
DB_HOST_PORT=5433
